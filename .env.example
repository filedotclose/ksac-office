# Database Connection String
MONGODB_URI=mongodb://localhost:27017/ksac_office

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production_min_32_chars
REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production_min_32_chars
NODE_ENV=development

# Institutional KSAC Mailer Configuration (Authoritative Sender & Reply-To)
KSAC_OFFICIAL_SMTP_EMAIL=ksac.office@kiit.ac.in
KSAC_SMTP_DISPLAY_NAME="Office of the Dean, KSAC"
DEAN_REPLYTO_EMAIL=deanksac@kiit.ac.in

# Dedicated Institutional SMTP Authentication Credentials
KSAC_SMTP_USER=ksac.office@kiit.ac.in
KSAC_SMTP_PASSWORD=your_institutional_smtp_app_password

# Fallback Development SMTP Credentials
SMTP_EMAIL=your_smtp_email@gmail.com
SMTP_PASSWORD=your_app_password
